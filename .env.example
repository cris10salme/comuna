# Copia este archivo a .env.local para desarrollo. En Vercel se ponen en
# Project → Settings → Environment Variables (nunca en el código).

# Obligatoria: API key de Anthropic (console.anthropic.com). Solo la lee el servidor (/api).
ANTHROPIC_API_KEY=

# Límites de uso (opcionales; estos son los valores por defecto)
DISENA_LIMIT_PER_HOUR=6      # diseños por persona y hora
CHAT_LIMIT_PER_HOUR=30       # mensajes de chat por persona y hora
AI_DAILY_LIMIT=400           # tope global de peticiones a la IA al día (control de gasto)
RATE_LIMIT_SALT=             # texto aleatorio para resumir las IPs (hash); pon uno propio

# Recomendado en producción: Upstash Redis (Vercel → Storage → Upstash for Redis) para que el
# límite sea compartido entre instancias. Vercel crea estas variables al conectarlo.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Solo en local: respuestas de prueba sin llamar a la API (nunca se activa en producción)
AI_MOCK=
